# Copy this file to `.env` for local development. On Render, set these in Dashboard -> Environment.

# Server Configuration (On Render, PORT is automatically injected; SERVER_PORT is used locally)
SERVER_PORT=4000

# Comma-separated list of allowed frontend origins (CORS) or '*' to allow all
# E.g. https://autorent-web.onrender.com,http://localhost:8443
CLIENT_ORIGIN=http://localhost:8443

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_string

# MySQL Database Configuration
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Optional: set to true if your database provider requires SSL
# DB_SSL=false
